# Copy to .env and fill in. Never commit .env.

# The hostname Caddy will get a certificate for. Point its A record at this VPS first.
RESQ_DOMAIN=resq.example.org
RESQ_ACME_EMAIL=you@example.org

# Two separate secrets, because the two risks are different.
#   ROVER    lets a client push telemetry (invent survivors on a live board)
#   OPERATOR lets a client command the rover (stop, release, drive)
# Generate each with:  openssl rand -base64 32
RESQ_ROVER_TOKEN=
RESQ_OPERATOR_TOKEN=

# Optional.
RESQ_MISSION_ID=RESQ-001
RESQ_BROADCAST_HZ=8

# Where the survey grid sits on Earth: the coordinate of its south-west corner, and the
# true bearing of its north edge (0 = the grid's north edge faces true north). This is
# declared by whoever set the mission up -- nothing infers it from a sensor. The shelter
# and route answers are about this point, so leaving the demo default in place means they
# are about downtown Cairo.
RESQ_ORIGIN_LAT=30.0444
RESQ_ORIGIN_LON=31.2357
RESQ_GRID_BEARING=0

# The mission record. On by default: an incident that leaves no trace cannot be reviewed.
# Under compose the directory is the resq_data volume and does not need setting here.
RESQ_RECORD=1
#RESQ_RECORD_DIR=/data
# Seconds between identical rows. 0 records every frame.
RESQ_RECORD_THROTTLE_S=2.0

# Road routing. Empty -- the default -- means no request ever leaves this machine and
# every route is the straight-line estimate. That is the field default: a Pi on a radio
# link must not block on a public service. Set it to https://router.project-osrm.org for
# real road routes on a box that has the internet.
RESQ_OSRM_URL=
